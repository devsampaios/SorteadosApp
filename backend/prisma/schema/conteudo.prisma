// Conteúdo postado numa disciplina (mural estilo chat): texto, link ou imagem.
// O autor (usuarioId) é referência solta — join manual em `usuario`, como nos
// demais vínculos. Imagem aponta para um Arquivo (referência solta também).
model Conteudo {
  id           BigInt   @id @default(autoincrement())
  disciplinaId BigInt   @map("disciplina_id")
  usuarioId    BigInt   @map("usuario_id")
  tipo         Int      @default(1)
  texto        String?
  link         String?
  arquivoId    BigInt?  @map("arquivo_id")
  criadoEm     DateTime @default(now()) @map("criadoem")

  disciplina Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)

  @@index([disciplinaId])
  @@index([usuarioId])
  @@map("conteudo")
}
