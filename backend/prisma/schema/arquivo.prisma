model Arquivo {
  id         BigInt  @id @default(autoincrement())
  nome       String
  extensao   String
  mimeType   String  @map("mimetype")
  temporario Boolean @default(true)

  usuarioId BigInt? @map("usuario_id")

  criadoEm DateTime @default(now()) @map("criadoem")

  @@index([temporario])
  @@index([usuarioId])
  @@map("arquivo")
}
