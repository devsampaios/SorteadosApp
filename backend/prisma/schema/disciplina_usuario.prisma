model DisciplinaUsuario {
  usuarioId    BigInt @map("usuario_id")
  disciplinaId BigInt @map("disciplina_id")

  papel    Int @default(1)
  situacao Int @default(1)

  criadoEm DateTime @default(now()) @map("criadoem")

  disciplina Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, disciplinaId])
  @@index([usuarioId])
  @@index([disciplinaId])
  @@map("disciplinadousuario")
}
