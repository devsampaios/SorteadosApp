model Usuario {
  id    BigInt @id @default(autoincrement())
  login String @unique
  // Hash bcrypt da senha (gerado com `npm run criptografar-senha`).
  senha String
  nome  String?

  situacao Int? @default(1)

  auditorias Auditoria[]

  criadoEm DateTime @default(now()) @map("criadoem")

  @@index([situacao])
  @@map("usuario")
}
