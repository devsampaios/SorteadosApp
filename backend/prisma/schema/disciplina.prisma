model Disciplina {
  id           BigInt    @id @default(autoincrement())
  codigo       String?
  nome         String
  professor    String?
  sala         String?
  cargaHoraria Int?      @map("cargahoraria")
  dataInicio   DateTime? @map("datainicio") @db.Date
  dataFim      DateTime? @map("datafim") @db.Date

  criadorId BigInt @map("criador_id")

  horarios           DisciplinaHorario[]
  avaliacoes         Avaliacao[]
  presencas          Presenca[]
  aulaTopicos        AulaTopico[]
  disciplinaUsuarios DisciplinaUsuario[]
  conteudos          Conteudo[]

  @@index([criadorId])
  @@map("disciplina")
}
